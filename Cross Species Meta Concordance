  Sex     = ifelse(grepl("^F_", colnames(mat)), "Female", "Male"),
  row.names = colnames(mat)
)


pheatmap(mat,
         color = pal_fdr, 
         breaks = seq(0, hi, length.out = 101),   # starts at 0, not -lim
         annotation_col = ann_col,
         cluster_rows = FALSE, 
         cluster_cols = FALSE,
         show_rownames = TRUE, 
         show_colnames = TRUE,
         fontsize_row = 12, 
