merge_nes <- function(gsea_list) {
  reduce(imap(gsea_list, ~ dplyr::select(.x, ID, !!.y := NES)),
         full_join, by = "ID") %>%
    filter(!is.na(ID)) %>%
    distinct(ID, .keep_all = TRUE) %>%
    tibble::column_to_rownames("ID") %>%
    as.matrix()
}

