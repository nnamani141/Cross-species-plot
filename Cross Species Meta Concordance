# Merge a list of metas into a wide log2FC matrix (genes x metas)
merge_logfc <- function(meta_list) {
  reduce(imap(meta_list, ~ .x %>% dplyr::select(gene, !!.y := log2FC)),
         full_join, by = "gene") %>%
    filter(!is.na(gene), gene != "") %>%       # drop NA
    distinct(gene, .keep_all = TRUE) %>%       # handle duplicate genes
    tibble::column_to_rownames("gene") %>%
    as.matrix()
}

## Create this for FDR
merge_FDR <- function(meta_list) {
  reduce(imap(meta_list, ~ .x %>% dplyr::select(gene, !!.y := fdr)),
         full_join, by = "gene") %>%
    filter(!is.na(gene), gene != "") %>%       # drop NA 
    distinct(gene, .keep_all = TRUE) %>%       # handle duplicate genes
    tibble::column_to_rownames("gene") %>%
    as.matrix()
}

